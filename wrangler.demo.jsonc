{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "equipment-manager-sheets-demo",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "DEMO_MODE": "true", "SHEET_TAB": "機材管理", "HEADER_ROW": "2", "FIRST_DATA_ROW": "3", "PERSON_START_COLUMN": "K", "PERSON_END_COLUMN": "BB", "MAX_DATA_ROWS": "1000", "AUDIT_TAB": "操作履歴" }
}
