{
  "name": "equipment-manager-sheets",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --config wrangler.demo.jsonc --port 8787",
    "dev:live": "wrangler dev --port 8787",
    "build": "vite build",
    "preview:demo": "npm run build && wrangler dev --config wrangler.demo.jsonc",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.2.0",
    "wrangler": "^4.45.0"
  }
}
